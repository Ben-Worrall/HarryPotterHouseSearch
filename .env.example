# Copy to .env and fill in as each step needs it. .env is gitignored.

# Sorting runs through Claude Code on your Pro plan: no key needed.
# Optional model alias passed to `claude --model` (e.g. sonnet, opus). Blank = Claude Code default.
SORTING_MODEL=
# Characters per nightly run
SORT_COUNT=40

# Only for the optional paid-API sorter (scripts/sort_with_api.py)
# ANTHROPIC_API_KEY=
# SORTING_MODEL_API=claude-sonnet-5-5

# Extra film data (later)
TMDB_API_KEY=

# Database — add these two in Vercel dashboard (Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (scripts, not Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local server
PORT=8080
HOST=0.0.0.0
